{# V3 first-screen conversion cluster. Pass hero_price, optional hero_proof
   (truthy to show the Google review badge), hero_book_href, hero_book_label.
   Phone and GBP URL come from fpr. #}
{% if hero_price is defined and hero_price %}
<p class="hero-price">{{ hero_price }}</p>
{% endif %}
{% if hero_proof is defined and hero_proof %}
<a class="hero-proof" href="{{ fpr.googleBusinessUrl | replace('&', '&amp;') }}" target="_blank" rel="noopener noreferrer" aria-label="Rated {{ fpr.aggregateRating.value }} out of 5 from 190 plus Google reviews"><span class="hero-proof-stars" aria-hidden="true"></span><strong>{{ fpr.aggregateRating.value }}</strong><span class="hero-proof-g" aria-hidden="true"><svg viewBox="0 0 24 24" width="15" height="15"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.57-1.96 1.09-.88z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg></span><span class="hero-proof-copy">190+ Google reviews</span></a>
{% endif %}
<div class="hero-actions">
  <a href="{{ hero_book_href if hero_book_href is defined else '/rentals' }}" class="btn btn-gold">{{ hero_book_label if hero_book_label is defined else 'Book Online' }}</a>
  <a href="tel:{{ fpr.phone }}" class="btn btn-outline-white">Call {{ fpr.phone }}</a>
</div>
