{# ============================================================================
   Forever Party Rentals — nav partial
   Renders skip link + #topbar + #nav (desktop + mobile).
   Inputs (provided by render_partials.py):
     fpr            — site_constants.json contents (phone/email/hours/logo/bookingUrl)
     cities         — list of {slug, name} in display order (28 entries)
     christmas_cities — list of {slug, name} for the Christmas dropdown subset
     tent_href      — dict mapping city slug -> tent rental URL (handles Surrey override)
   Markup intentionally matches shared.js buildNav() byte-for-byte (modulo
   whitespace) so client-side hydration attaches to the same DOM shape.
   ============================================================================ #}
<a href="#main" class="skip-link">Skip to main content</a>

<div id="topbar" role="complementary" aria-label="Contact information">
    <div class="container">
      <a class="tb-item" href="tel:{{ fpr.phone }}" aria-label="Call us at {{ fpr.phone }}"><span class="tb-ico" aria-hidden="true">✆</span>{{ fpr.phone }}</a>
      <a class="tb-item" href="mailto:{{ fpr.email }}" aria-label="Email us at {{ fpr.email }}"><span class="tb-ico" aria-hidden="true">✉</span>{{ fpr.email }}</a>
      <span class="tb-item tb-muted" aria-hidden="true">{{ fpr.hours }}</span>
    </div>
</div>

<nav id="nav" aria-label="Main navigation">
    <div class="container nav-inner">
      <a class="nav-logo" href="/" aria-label="Forever Party Rentals — home"><img src="{{ fpr.logo }}" alt="Forever Party Rentals" width="125" height="125"/></a>
      <div class="nav-links" role="menubar">

        <div class="nav-link">
          <button type="button" class="nav-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="dd-tents">Tent Rentals <span aria-hidden="true">▾</span></button>
          <div class="dropdown" id="dd-tents" role="menu" aria-label="Tent Rentals">
            <a role="menuitem" href="/tents">All Tent Rentals</a>
            <div class="dropdown-sub">
              <a role="menuitem" href="/marquee-tent-rental-lowermainland-surrey-langley-vancouver" aria-haspopup="true">Marquee Tent Rental Lower Mainland <span class="dropdown-sub-caret" aria-hidden="true">▸</span></a>
              <div class="subdropdown" role="menu" aria-label="Marquee Tent Sizes">
                <a role="menuitem" href="/product-marquee-tent-20x20">20×20 Marquee Tent</a>
                <a role="menuitem" href="/product-marquee-tent-20x30">20×30 Marquee Tent</a>
                <a role="menuitem" href="/product-marquee-tent-20x40">20×40 Marquee Tent</a>
                <a role="menuitem" href="/product-marquee-tent-20x60">20×60 Marquee Tent</a>
                <a role="menuitem" href="/product-marquee-tent-30x60">30×60 Marquee Tent</a>
              </div>
            </div>
            <a role="menuitem" href="/product-popup-tent-10x10">10×10 Popup Tent</a>
            <a role="menuitem" href="/product-tent-sidewall">Tent Sidewalls</a>
            <a role="menuitem" href="/product-tent-heater">Tent Heaters</a>
            <a role="menuitem" href="/tent-size-calculator">What Size Tent? — Calculator</a>
          </div>
        </div>

        <div class="nav-link">
          <button type="button" class="nav-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="dd-chairs">Chair Rentals <span aria-hidden="true">▾</span></button>
          <div class="dropdown" id="dd-chairs" role="menu" aria-label="Chair Rentals">
            <a role="menuitem" href="/chairs">All Chair Rentals</a>
            <a role="menuitem" href="/product-white-chiavari-chair">Chiavari Chairs</a>
            <a role="menuitem" href="/product-fanback-garden-chair">Fanback Chairs</a>
            <a role="menuitem" href="/product-resin-garden-chair">Resin Garden Chairs</a>
          </div>
        </div>

        <div class="nav-link">
          <button type="button" class="nav-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="dd-tables">Table Rentals <span aria-hidden="true">▾</span></button>
          <div class="dropdown" id="dd-tables" role="menu" aria-label="Table Rentals">
            <a role="menuitem" href="/tables">All Table Rentals</a>
            <a role="menuitem" href="/product-banquet-table-8ft">8ft Banquet Tables</a>
            <a role="menuitem" href="/product-banquet-table-6ft">6ft Banquet Tables</a>
            <a role="menuitem" href="/product-round-table-5ft">5ft Round Tables</a>
            <a role="menuitem" href="/product-cocktail-table">Cocktail Tables</a>
          </div>
        </div>

        <div class="nav-link"><a href="/dance-floor">Dance Floor</a></div>

        <div class="nav-link"><a href="/event-layout-planner">Layout Planner</a></div>

        <div class="nav-link">
          <button type="button" class="nav-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="dd-misc">Misc <span aria-hidden="true">▾</span></button>
          <div class="dropdown" id="dd-misc" role="menu" aria-label="More Rentals">
            <div class="dropdown-sub">
              <a role="menuitem" href="/battery-power-stations" aria-haspopup="true">Battery &amp; Power Stations <span class="dropdown-sub-caret" aria-hidden="true">▸</span></a>
              <div class="subdropdown" role="menu" aria-label="Battery and Power Station Rentals">
                <a role="menuitem" href="/battery-power-stations">All Battery &amp; Power Stations</a>
                <a role="menuitem" href="/product-ecoflow-delta-2">EcoFlow Delta 2 (1024 Wh)</a>
                <a role="menuitem" href="/product-ecoflow-delta-3-max">EcoFlow Delta 3 Max (2048 Wh)</a>
                <a role="menuitem" href="/product-ecoflow-delta-3-ultra">EcoFlow Delta 3 Ultra (3072 Wh)</a>
                <a role="menuitem" href="/product-ecoflow-220w-solar-panel">220W Solar Panel + Add-ons</a>
              </div>
            </div>
            <a role="menuitem" href="/starlink-rentals">Starlink Internet</a>
            <a role="menuitem" href="/projector-rentals">Projector &amp; Screen</a>
          </div>
        </div>

        <div class="nav-link">
          <button type="button" class="nav-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="dd-packages">Packages <span aria-hidden="true">▾</span></button>
          <div class="dropdown" id="dd-packages" role="menu" aria-label="Event Packages">
            <a role="menuitem" href="/packages">All Packages</a>
            <div class="dropdown-sub">
              <a role="menuitem" href="/packages#wedding" aria-haspopup="true">Wedding Packages <span class="dropdown-sub-caret" aria-hidden="true">▸</span></a>
              <div class="subdropdown" role="menu" aria-label="Wedding Package Sizes">
                <a role="menuitem" href="/wedding-package-50-guests">50 Guests</a>
                <a role="menuitem" href="/wedding-package-100-guests">100 Guests</a>
                <a role="menuitem" href="/wedding-package-150-guests">150 Guests</a>
              </div>
            </div>
            <div class="dropdown-sub">
              <a role="menuitem" href="/packages#corporate" aria-haspopup="true">Corporate Packages <span class="dropdown-sub-caret" aria-hidden="true">▸</span></a>
              <div class="subdropdown" role="menu" aria-label="Corporate Package Sizes">
                <a role="menuitem" href="/corporate-package-50-guests">50 Guests</a>
                <a role="menuitem" href="/corporate-package-100-guests">100 Guests</a>
                <a role="menuitem" href="/corporate-package-150-guests">150 Guests</a>
              </div>
            </div>
            <div class="dropdown-sub">
              <a role="menuitem" href="/packages#backyard" aria-haspopup="true">Backyard Packages <span class="dropdown-sub-caret" aria-hidden="true">▸</span></a>
              <div class="subdropdown" role="menu" aria-label="Backyard Package Sizes">
                <a role="menuitem" href="/backyard-package-50-guests">50 Guests</a>
                <a role="menuitem" href="/backyard-package-100-guests">100 Guests</a>
                <a role="menuitem" href="/backyard-package-150-guests">150 Guests</a>
              </div>
            </div>
            <div class="dropdown-sub">
              <a role="menuitem" href="/carnival-games" aria-haspopup="true">Carnival Games <span class="dropdown-sub-caret" aria-hidden="true">▸</span></a>
              <div class="subdropdown" role="menu" aria-label="Carnival Game Bundles">
                <a role="menuitem" href="/carnival-games">All Carnival Games</a>
                <a role="menuitem" href="/carnival-games-bundle-2">2-Game Bundle</a>
                <a role="menuitem" href="/carnival-games-bundle-4">4-Game Bundle</a>
              </div>
            </div>
          </div>
        </div>

        <div class="nav-link" style="position:relative">
          <button type="button" class="nav-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="dd-areas">Service Areas <span aria-hidden="true">▾</span></button>
          <div class="mega-dropdown" id="dd-areas" role="menu" aria-label="Service Areas">
            <a role="menuitem" href="/service-areas" class="mega-all">All Service Areas</a>
            <div class="mega-divider" aria-hidden="true"></div>
            <div class="mega-col-title">Party Rentals By City</div>
            <div class="mega-dropdown-inner">{% for c in cities %}<a role="menuitem" href="/{{ c.slug }}-party-rentals">{{ c.name }}</a>{% endfor %}</div>
            <div class="mega-divider" aria-hidden="true"></div>
            <div class="mega-col-title">Christmas Lights By City (14)</div>
            <div class="mega-dropdown-inner">{% for c in christmas_cities %}<a role="menuitem" href="/christmas-lights-{{ c.slug }}">{{ c.name }}</a>{% endfor %}</div>
          </div>
        </div>

        <div class="nav-link"><a href="/contact">Contact</a></div>
      </div>
      <a class="btn btn-primary nav-cta" href="{{ fpr.bookingUrl }}">Book Now</a>
      <button type="button" class="nav-hamburger" id="navToggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="navMobile">
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
    <div class="nav-mobile" id="navMobile" role="menu" aria-label="Mobile navigation" hidden>
      <a role="menuitem" href="/">Home</a>
      <a role="menuitem" href="/tents">Tent Rentals</a>
      <a role="menuitem" href="/marquee-tent-rental-lowermainland-surrey-langley-vancouver">Marquee Tent Rental Lower Mainland</a>
      <a role="menuitem" href="/chairs">Chair Rentals</a>
      <a role="menuitem" href="/tables">Table Rentals</a>
      <a role="menuitem" href="/dance-floor">Dance Floor</a>
      <a role="menuitem" href="/event-layout-planner">Free Layout Planner</a>
      <a role="menuitem" href="/battery-power-stations">Battery &amp; Power Stations</a>
      <a role="menuitem" href="/starlink-rentals">Starlink Internet</a>
      <a role="menuitem" href="/projector-rentals">Projector &amp; Screen</a>
      <a role="menuitem" href="/packages">Event Packages</a>
      <a role="menuitem" href="/service-areas">Service Areas</a>
      <a role="menuitem" href="/contact">Contact</a>
      <a role="menuitem" href="{{ fpr.bookingUrl }}" style="color:var(--green);font-weight:600;margin-top:8px">→ Book Now Online</a>
    </div>
</nav>
{# Mobile sticky CTA bar — rendered on every page, displayed only ≤768px
   (see .mobile-cta-bar in shared.css). Suppressed at runtime on /checkout and
   the layout-planner pages, where Adelie checkout / the planner own the bottom
   of the viewport. #}
<div id="fprCtaBar" class="mobile-cta-bar" role="navigation" aria-label="Call or book">
  <a class="mcb-call" href="tel:{{ fpr.phone }}"><span aria-hidden="true">✆</span>&nbsp;{{ fpr.phone }}</a>
  <a class="mcb-book" href="{{ fpr.bookingUrl }}">Book Online</a>
</div>
<script>(function(){if(/checkout|layout-planner|^\/planner/.test(location.pathname)){var b=document.getElementById('fprCtaBar');if(b){b.hidden=true;}document.documentElement.classList.add('no-cta-bar');}})();</script>
